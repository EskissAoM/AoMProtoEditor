<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ce="using:AoMDivineDataEditor.Windows"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="AoMDivineDataEditor.Windows.ProtoEditorWindow"
        x:DataType="ce:ProtoEditorWindow"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1440" Height="900"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Title="AoM Divine Data Editor">

    <Window.Resources>
        <StreamGeometry x:Key="PageSearchCaseSensitiveIconPath">m186 768 140-380h30l143 380h-32l-40-113H257l-40 113h-31Zm80-139h151l-75-209h-1l-75 209Zm398 148q-40 0-62.5-21.5T579 697q0-41 27-65.5t74-24.5q18 0 39.5 5t32.5 11v-24q0-39-20-60t-56-21q-20 0-35.5 6T605 544l-17-19q20-16 42.5-23.5T677 494q50 0 75 27.5t25 81.5v164h-26v-39h-4q-17 27-36 38t-47 11Zm-2-26q40 0 64.5-29.5T751 646q-13-8-29.5-12.5T684 629q-35 0-56.5 18.5T606 696q0 26 15 40.5t41 14.5Z</StreamGeometry>
        <StreamGeometry x:Key="PageSearchCompleteWordIconPath">M124 764V650h20v94h672v-94h20v114H124Zm266.903-93v-39H387q-17 27-36 38t-46.737 11q-38.789 0-62.026-21.695Q219 637.611 219 601q0-41 27-65.5t73-24.5q18 0 39.5 5t33.5 11v-24q0-39-19.5-60T318 422q-21 0-37 6t-36 20l-17-19q20-16 42.5-23.5t47.84-7.5q49.66 0 74.16 27.284 24.5 27.283 24.5 81.974V671h-26.097ZM324 533q-34 0-56 18.5T246 599q0 27 15.667 41.5Q277.333 655 303 655q40 0 64-29.706t24-75.576Q378 542 361.5 537.5T324 533Zm197 139V285h25v136.182L543 460h2q15-23 37.083-34t49.189-11Q679 415 707 450.5q28 35.5 28 98.5 0 61-28.073 96.5-28.072 35.5-76.53 35.5Q603 681 580 669t-35-33h-2v36h-22Zm108-229q-36 0-61 30.159t-25 76.523Q543 596 568 626.5t61 30.5q36 0 57.5-29t21.5-78q0-49-21.5-78T629 443Z</StreamGeometry>
        <StreamGeometry x:Key="PageSearchRegularExpressionIconPath">M251 817q-49-48-76.5-109.5T147 577q0-69 27-131.5T251 335l16 14q-48 44-74 103t-26 124q0 64 26 122.5T266 803l-15 14Zm121-27q-14 0-24-10t-10-24q0-14 10-24t24-10q14 0 24 10t10 24q0 14-10 24t-24 10Zm158-192V496l-88 51-10-16 88-51-88-51 10-16 88 51V362h20v102l88-51 10 16-88 51 88 51-10 16-88-51v102h-20Zm178 219-15-14q47-44 73-103t26-124q0-65-25.5-123.5T693 349l15-14q49 49 76.5 111T812 577q0 69-27.5 131.5T708 817Z</StreamGeometry>
        <StreamGeometry x:Key="PageSearchFindPreviousIconPath">M470 824V367L247 590l-15-14 248-248 248 248-15 14-223-223v457h-20Z</StreamGeometry>
        <StreamGeometry x:Key="PageSearchFindNextIconPath">M480 824 232 576l15-14 223 223V328h20v457l223-223 15 14-248 248Z</StreamGeometry>
        <StreamGeometry x:Key="PageSearchCloseIconPath">m291 780-15-15 189-189-189-189 15-15 189 189 189-189 15 15-189 189 189 189-15 15-189-189-189 189Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.PageSearchQueryMatch">
            <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
        </Style>
        <Style Selector="TabItem.editorTab">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="#171A19" />
            <Setter Property="BorderBrush" Value="#493E30" />
        </Style>
        <Style Selector="TabItem.editorTab:selected">
            <Setter Property="Foreground" Value="#F0E2C9" />
            <Setter Property="Background" Value="#24231E" />
            <Setter Property="BorderBrush" Value="#8A693B" />
        </Style>
        <Style Selector="Button.topNav">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#171A19" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#493E30" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.topNav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#202321" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        </Style>
        <Style Selector="Button.topSave">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource PositiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PositiveBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PositiveTextBrush}" />
        </Style>
        <Style Selector="Button.topSave:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PositiveHoverBrush}" />
            <Setter Property="BorderBrush" Value="#B99550" />
        </Style>

        <Style Selector="Button.entitySelector">
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#181B1A" />
            <Setter Property="Foreground" Value="#BEB5A7" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        </Style>
        <Style Selector="Button.entitySelector.active">
            <Setter Property="Background" Value="#2D2920" />
            <Setter Property="Foreground" Value="#F0E2C9" />
            <Setter Property="BorderBrush" Value="#9B753E" />
        </Style>
        <Style Selector="TabStripItem.documentTab">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource DocumentTabBrush}" />
            <Setter Property="Foreground" Value="#B7AEA0" />
            <Setter Property="BorderBrush" Value="#393A35" />
        </Style>
        <Style Selector="TabStripItem.documentTab:selected">
            <Setter Property="Background" Value="{DynamicResource DocumentTabActiveBrush}" />
            <Setter Property="Foreground" Value="#EEE2CE" />
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        </Style>
        <Style Selector="Button.topMenuItem">
            <Setter Property="Width" Value="125" />
            <Setter Property="MinWidth" Value="125" />
            <Setter Property="MaxWidth" Value="125" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

    </Window.Styles>

    <Grid>
    <DockPanel>
        <!-- Menu bar / Top toolbar -->
        <Border x:Name="_mainToolbar" Classes="MainPanel" DockPanel.Dock="Top" BorderThickness="0,0,0,1" Height="48">
            <DockPanel Margin="10,0">
                <Button x:Name="_saveButton"
                        DockPanel.Dock="Right"
                        Classes="topSave"
                        Content="Save"
                        PointerPressed="SaveButton_PointerPressed"
                        Click="Save_Click"
                        MinWidth="80"
                        VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="topNav" Content="Mods">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="4" Margin="4">
                                    <Button Classes="topMenuItem"
                                            Content="Create a mod"
                                            Click="CreateMod_Click" />
                                    <Button Classes="topMenuItem"
                                            Content="Switch mod"
                                            Click="SwitchMod_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Classes="topNav" Content="Protounit">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="4" Margin="4">
                                    <Button Classes="topMenuItem"
                                            Content="Edit/view"
                                            Click="ProtounitEditView_Click" />
                                    <Button Classes="topMenuItem"
                                            Content="Tactics"
                                            Click="ProtounitTactics_Click" />
                                    <Button Classes="topMenuItem"
                                            Content="Commands"
                                            Click="ProtounitCommands_Click" />
                                    <Button Classes="topMenuItem"
                                            Content="Abilities"
                                            Click="ProtounitAbilities_Click" />
                                    <Button Classes="topMenuItem"
                                            Content="Unit Type"
                                            Click="ProtounitUnitType_Click" />
                                    <Button Classes="topMenuItem"
                                            Content="Icon"
                                            Click="ProtounitIcon_Click" />
                                    <Button Classes="topMenuItem"
                                            Content="Anim File"
                                            Click="ProtounitAnimFile_Click" />
                                    <Button Classes="topMenuItem"
                                            Content="Sound Set"
                                            Click="ProtounitSoundSet_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Classes="topNav" Content="Technology">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="4" Margin="4">
                                    <Button Classes="topMenuItem"
                                            Content="Edit / View"
                                            Click="TechnologyEditView_Click" />
                                    <Button Classes="topMenuItem"
                                            Content="Tech Types"
                                            Click="TechnologyTechTypes_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="topNav" Content="Gods" Click="Gods_Click" />
                    <Button Classes="topNav" Content="Settings" Click="Settings_Click" />
                </StackPanel>

                <!-- Kept only as an internal status sink for existing load/save code. -->
                <TextBlock x:Name="_fileLabel" IsVisible="False" />
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid x:Name="_mainContentGrid" RowDefinitions="Auto,*">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="280" MinWidth="28" />
            </Grid.ColumnDefinitions>
            <!-- Left panel: unit list -->
            <Border x:Name="_unitListPanel" Classes="MainPanel" Grid.Column="0" Grid.RowSpan="2" BorderThickness="0,0,1,0" Padding="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Classes="RaisedPanel"
                            x:Name="_entitySelectorContainer"
                            Padding="6"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                            <Button x:Name="_unitsEntityButton" Classes="entitySelector active" Content="Units" Click="UnitsEntity_Click" />
                            <Button x:Name="_techsEntityButton" Grid.Column="1" Classes="entitySelector" Content="Technologies" Click="TechsEntity_Click" />
                            <Button x:Name="_godsEntityButton" Grid.Row="1" Classes="entitySelector" Content="Gods" Click="GodsEntity_Click" />
                            <Button x:Name="_powersEntityButton" Grid.Row="1" Grid.Column="1" Classes="entitySelector" Content="Powers" IsEnabled="False" ToolTip.Tip="Power editing is not available yet." />
                        </Grid>
                    </Border>

                    <TextBlock DockPanel.Dock="Top"
                               x:Name="_entityListHeading"
                               Text="Units"
                               FontWeight="Bold"
                               FontSize="14"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,6" />
                    
                    <TextBox DockPanel.Dock="Top" x:Name="_searchBox" PlaceholderText="Search..." Margin="0,0,0,6" TextChanged="SearchBox_TextChanged" />
                    
                    <TabStrip DockPanel.Dock="Top" x:Name="_unitTabs" Margin="0,0,0,6" SelectionChanged="UnitTab_SelectionChanged">
                        <TabStripItem x:Name="_originalTab" FontSize="14" Padding="8,4">Original</TabStripItem>
                        <TabStripItem x:Name="_modifiedTab" FontSize="14" Padding="8,4">Modified</TabStripItem>
                    </TabStrip>
                    
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" Margin="0,6,0,0" ColumnSpacing="6">
                        <Button x:Name="_entityAddButton" Grid.Column="0" Classes="add-item" Content="Add" Click="EntityAdd_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button x:Name="_entityDeleteButton" Grid.Column="1" Classes="danger" Content="🗑 Delete" Click="EntityDelete_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </Grid>
                    
                    <ListBox x:Name="_unitList"
                             SelectionChanged="UnitList_SelectionChanged"
                             ContextRequested="UnitList_ContextRequested" />
                </DockPanel>
            </Border>

            <GridSplitter x:Name="_unitListSplitter" Grid.Column="1" Grid.RowSpan="2" Width="5" Background="{DynamicResource SubtleBorderBrush}" ResizeDirection="Columns" />

            <Border x:Name="_documentTabsHost"
                    Grid.Column="2"
                    Grid.ColumnSpan="3"
                    Grid.Row="0"
                    Background="{DynamicResource MainPanelBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,3">
                <ScrollViewer x:Name="_documentTabsScroller"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ScrollViewer.Styles>
                        <Style Selector="ScrollBar:horizontal">
                            <Setter Property="Height" Value="6" />
                        </Style>
                    </ScrollViewer.Styles>
                    <!-- Keep the overlay scrollbar in reserved space below the 40px tabs.
                         Its expanded hover state must never cover the tab hit targets. -->
                    <Border Padding="0,0,0,14">
                        <TabStrip x:Name="_documentTabs" SelectionChanged="DocumentTabs_SelectionChanged" />
                    </Border>
                </ScrollViewer>
            </Border>

            <!-- Right panel: fixed tools + scrollable editor -->
            <Border Grid.Column="2" Grid.Row="1" Classes="MainPanel" BorderThickness="0" Padding="16,16,4,16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto,*,Auto"
                          Margin="0,0,0,10">
                        <Border Grid.Column="2"
                                x:Name="_pageSearchPanel"
                                IsVisible="False"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,4,4"
                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                Background="{DynamicResource RaisedPanelBrush}"
                                Padding="8">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="_pageSearchBox"
                                             Width="265"
                                             PlaceholderText="Find...">
                                        <TextBox.InnerRightContent>
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton x:Name="_pageSearchMatchCaseToggle"
                                                              Background="Transparent"
                                                              Foreground="{DynamicResource SecondaryTextBrush}"
                                                              BorderThickness="0"
                                                              MinWidth="22"
                                                              MinHeight="20"
                                                              Padding="4"
                                                              ToolTip.Tip="Match case">
                                                    <Path Data="{StaticResource PageSearchCaseSensitiveIconPath}"
                                                          Width="12"
                                                          Height="12"
                                                          Stretch="Uniform"
                                                          Fill="{Binding $parent[ToggleButton].Foreground}"
                                                          Stroke="{Binding $parent[ToggleButton].Foreground}"
                                                          StrokeThickness="1" />
                                                </ToggleButton>
                                                <ToggleButton x:Name="_pageSearchWholeWordToggle"
                                                              Background="Transparent"
                                                              Foreground="{DynamicResource SecondaryTextBrush}"
                                                              BorderThickness="0"
                                                              MinWidth="22"
                                                              MinHeight="20"
                                                              Padding="4"
                                                              Margin="3,0,0,0"
                                                              ToolTip.Tip="Match whole words">
                                                    <Path Data="{StaticResource PageSearchCompleteWordIconPath}"
                                                          Width="14"
                                                          Height="12"
                                                          Stretch="Uniform"
                                                          Fill="{Binding $parent[ToggleButton].Foreground}"
                                                          Stroke="{Binding $parent[ToggleButton].Foreground}"
                                                          StrokeThickness="1" />
                                                </ToggleButton>
                                                <ToggleButton x:Name="_pageSearchRegexToggle"
                                                              Background="Transparent"
                                                              Foreground="{DynamicResource SecondaryTextBrush}"
                                                              BorderThickness="0"
                                                              MinWidth="22"
                                                              MinHeight="20"
                                                              Padding="4"
                                                              Margin="3,0,5,0"
                                                              ToolTip.Tip="Use regex">
                                                    <Path Data="{StaticResource PageSearchRegularExpressionIconPath}"
                                                          Width="12"
                                                          Height="12"
                                                          Stretch="Uniform"
                                                          Fill="{Binding $parent[ToggleButton].Foreground}"
                                                          Stroke="{Binding $parent[ToggleButton].Foreground}"
                                                          StrokeThickness="1" />
                                                </ToggleButton>
                                            </StackPanel>
                                        </TextBox.InnerRightContent>
                                    </TextBox>
                                    <Button x:Name="_pageSearchPreviousButton"
                                            Margin="5,0,0,0"
                                            MinWidth="34"
                                            BorderThickness="0"
                                            Padding="4"
                                            ToolTip.Tip="Find previous">
                                        <Path Data="{StaticResource PageSearchFindPreviousIconPath}"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Fill="{Binding $parent[Button].Foreground}"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="1" />
                                    </Button>
                                    <Button x:Name="_pageSearchNextButton"
                                            Margin="3,0,0,0"
                                            MinWidth="34"
                                            BorderThickness="0"
                                            Padding="4"
                                            ToolTip.Tip="Find next">
                                        <Path Data="{StaticResource PageSearchFindNextIconPath}"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Fill="{Binding $parent[Button].Foreground}"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="1" />
                                    </Button>
                                    <Button x:Name="_pageSearchCloseButton"
                                            Margin="3,0,0,0"
                                            MinWidth="34"
                                            BorderThickness="0"
                                            Padding="4"
                                            ToolTip.Tip="Close search">
                                        <Path Data="{StaticResource PageSearchCloseIconPath}"
                                              Width="12"
                                              Height="12"
                                              Stretch="Uniform"
                                              Fill="{Binding $parent[Button].Foreground}"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="1" />
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="_pageSearchMatchCountText"
                                           Text=""
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="2,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                            <TextBlock Text="Unit :" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="_unitNameBox" Width="380" MaxWidth="380" HorizontalAlignment="Left" FontSize="16" FontWeight="SemiBold" TextChanged="UnitNameBox_TextChanged" />
                            <Button Grid.Column="2"
                                    x:Name="_sectionsButton"
                                    Content="Sections"
                                    IsVisible="False"
                                    IsEnabled="False"
                                    Padding="12,5"
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <ScrollViewer MaxHeight="420"
                                                      MinWidth="220"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="_sectionsFlyoutPanel"
                                                        Spacing="4"
                                                        Margin="4" />
                                        </ScrollViewer>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <TabControl Grid.Row="1" x:Name="_editorTabs" SelectedIndex="0" SelectionChanged="EditorTab_SelectionChanged">
                            <TabItem Classes="editorTab" Header="Stats">
                                <ScrollViewer x:Name="_editorScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="_statsEditorPanel" Classes="statsEditor" Spacing="10" Margin="0,0,15,0" />
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Classes="editorTab" Header="Actions">
                                <ScrollViewer x:Name="_actionsEditorScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="_actionsEditorPanel" Spacing="10" Margin="0,0,15,0" />
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Classes="editorTab" Header="Commands">
                                <ScrollViewer x:Name="_commandsEditorScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="_commandsEditorPanel" Spacing="10" Margin="0,0,15,0" />
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Classes="editorTab" Header="Abilities">
                                <ScrollViewer x:Name="_abilitiesEditorScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="_abilitiesEditorPanel" Spacing="10" Margin="0,0,15,0" />
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Classes="editorTab" Header="Train/Research">
                                <ScrollViewer x:Name="_trainResearchEditorScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="_trainResearchEditorPanel" Spacing="10" Margin="0,0,15,0" />
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <TextBlock Grid.Row="2" x:Name="_statusMessage" Text="" Foreground="{DynamicResource MainGoldBrush}" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <GridSplitter x:Name="_previewSplitter" Grid.Column="3" Grid.Row="1" Width="5" Background="{DynamicResource SubtleBorderBrush}" ResizeDirection="Columns" />
            <Border x:Name="_xmlPreviewPanel" Classes="XmlPanel" Grid.Column="4" Grid.Row="1" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid x:Name="_xmlPreviewContent" RowDefinitions="Auto,*" Margin="12">
                        <Grid ColumnDefinitions="*,Auto" Margin="28,0,0,8">
                            <TextBlock Classes="XmlHeader" Text="XML Preview" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="_applyXmlPreviewButton" Classes="positive" Content="Apply" IsVisible="False" Padding="12,4" Click="ApplyXmlPreview_Click" />
                        </Grid>
                        <avaloniaEdit:TextEditor Grid.Row="1" x:Name="_xmlPreviewText" IsReadOnly="True"
                                                 FontFamily="Consolas" FontSize="12"
                                                 Background="{DynamicResource XmlEditorBrush}"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 BorderBrush="{DynamicResource NormalBorderBrush}"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="XmlPreviewText_TextChanged" />
                    </Grid>
                    <Button x:Name="_xmlPreviewToggleButton"
                            Content="&#x25B6;"
                            Width="20"
                            Height="24"
                            MinWidth="20"
                            MinHeight="24"
                            FontSize="10"
                            Padding="0"
                            Background="{DynamicResource DeepPanelBrush}"
                            BorderBrush="{DynamicResource NormalBorderBrush}"
                            BorderThickness="0"
                            CornerRadius="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="4,8,0,0"
                            ZIndex="1"
                            ToolTip.Tip="Collapse XML Preview"
                            Click="XmlPreviewToggle_Click" />
                </Grid>
            </Border>
            <ContentControl x:Name="_technologyHost" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="1" IsVisible="False" ZIndex="20" />
            <Border x:Name="_emptyDocumentOverlay"
                    Grid.Column="2"
                    Grid.ColumnSpan="3"
                    Grid.Row="1"
                    IsVisible="True"
                    Background="{DynamicResource AppBackgroundBrush}"
                    ZIndex="30">
                <TextBlock x:Name="_emptyDocumentMessage"
                           Text="Click on a unit to start"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>
    </DockPanel>
        <Border x:Name="_startupLoadingOverlay"
                IsVisible="False"
                Background="#E60D0F0E"
                ZIndex="10">
            <StackPanel Width="280"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressBar IsIndeterminate="True"
                             Height="8" />
                <TextBlock x:Name="_startupLoadingText"
                           Text="Loading AoM Divine Data Editor..."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
