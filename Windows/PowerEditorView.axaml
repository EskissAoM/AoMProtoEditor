                <Grid x:Name="_droughtTerrainCreepRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><Grid><TextBlock x:Name="_terrainCreepLabel" Text="Terrain Creep" VerticalAlignment="Top" Margin="0,9,0,0"/><Button x:Name="_addTerrainCreepButton" Content="Terrain Creep" Classes="add-component" HorizontalAlignment="Left" Click="AddTerrainCreep_Click"/></Grid><StackPanel Grid.Column="1" x:Name="_droughtTerrainCreepHost" Spacing="4"/></Grid>
                <Grid x:Name="_droughtVfxRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock x:Name="_droughtVfxMainLabel" Text="Land VFX" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel x:Name="_droughtLandVfxFields" Orientation="Horizontal" Margin="0,0,14,4"><AutoCompleteBox x:Name="_droughtLandVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel x:Name="_droughtWaveUnitFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock x:Name="_droughtWaveUnitInlineLabel" Text="Wave Unit" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_droughtWaveUnitBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_droughtInitialDamageRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Initial damage" VerticalAlignment="Top" Margin="0,9,0,0"/><StackPanel Grid.Column="1"><StackPanel x:Name="_droughtInitialDamageRows" Spacing="4"/><Button x:Name="_addDroughtInitialDamageButton" Content="Add Initial damage" Classes="add-component" HorizontalAlignment="Left" Click="AddDroughtInitialDamage_Click"/></StackPanel></Grid>
                <Grid x:Name="_droughtBurnTimeRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Burn Time" VerticalAlignment="Center"/><TextBox Grid.Column="1" HorizontalAlignment="Left" x:Name="_droughtBurnTimeBox" Tag="burntime" TextChanged="SpecificNumber_TextChanged"/></Grid>

                <Grid x:Name="_greatFloodWaveRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Wave Unit" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><AutoCompleteBox x:Name="_greatFloodWaveUnitBox" Width="200" MaxWidth="200" Margin="0,0,14,4" FilterMode="Contains" MinimumPrefixLength="0"/><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Count" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_greatFloodWaveCountBox" Tag="wavecount" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Radius" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_greatFloodWaveRadiusBox" Tag="waveradius" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Spacing" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_greatFloodSpacingBox" Tag="spacingdistance" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_greatFloodVelocityRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Velocity" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Initial" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_greatFloodInitialVelocityBox" Tag="initialvelocity" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Final" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_greatFloodFinalVelocityBox" Tag="finalvelocity" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Ramp Time" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_greatFloodRampTimeBox" Tag="ramptime" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_greatFloodAttackRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock x:Name="_greatFloodAttackMainLabel" Text="Attack" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel x:Name="_greatFloodAttackActionFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Action name" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_greatFloodAttackNameBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel x:Name="_greatFloodAttackIntervalFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock x:Name="_greatFloodAttackIntervalLabel" Text="Interval" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_greatFloodAttackIntervalBox" Tag="attackinterval" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_greatFloodDamageCapRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Damage Cap" VerticalAlignment="Top" Margin="0,9,0,0"/><StackPanel Grid.Column="1"><StackPanel x:Name="_greatFloodDamageCapRows" Spacing="4"/><Button x:Name="_addGreatFloodDamageCapButton" Content="Damage Cap" Classes="add-component" HorizontalAlignment="Left" Click="AddGreatFloodDamageCap_Click"/></StackPanel></Grid>

                <Grid x:Name="_shiftingSandsPortalRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
                  <TextBlock Text="Portal" VerticalAlignment="Center"/>
