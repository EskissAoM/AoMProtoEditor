                      <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Target Large" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_rainLargeTargetBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="VFX" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_rainLargeVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel>
                    </WrapPanel>
                    <WrapPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Target Small" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_rainSmallTargetBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel>
