                  <WrapPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Area VFX" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_effectInAreaAreaVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/><TextBlock Text="*Requires to have HandAttack and tactics" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
