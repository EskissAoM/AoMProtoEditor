                  </StackPanel>
                </Grid>

                <Grid x:Name="_switchingTypeRow" ColumnDefinitions="150,*" Margin="0,4">
                  <TextBlock Text="Type" VerticalAlignment="Top" Margin="0,9,0,0"/>
                  <WrapPanel Grid.Column="1">
                    <ComboBox x:Name="_switchingTierTypeBox" Width="180" Margin="0,0,14,4" SelectionChanged="SwitchingTierType_SelectionChanged"/>
                    <StackPanel x:Name="_switchingIntervalFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Interval (s)" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_switchingIntervalBox" Tag="interval" TextChanged="SwitchingInterval_TextChanged"/></StackPanel>
                  </WrapPanel>
                </Grid>
                <Grid x:Name="_switchingProgressRow" ColumnDefinitions="150,*" Margin="0,4">
                  <TextBlock Text="Progress" VerticalAlignment="Center"/>
                  <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,4"><TextBlock Text="Visual" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="_switchingProgressTypeBox" Width="170" VerticalAlignment="Center" SelectionChanged="SwitchingProgressType_SelectionChanged"/></StackPanel>
                    <StackPanel x:Name="_switchingTimerRolloverFields" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,4"><TextBlock Text="Timer Rollover" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_switchingTimerRolloverBox" Width="240" MinHeight="32" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="SwitchingStringBox_TextChanged"/><Button x:Name="_removeSwitchingTimerRolloverButton" Classes="remove-button" VerticalAlignment="Center" Margin="2,0,0,0" Click="RemoveSwitchingTimerRollover_Click"/></StackPanel>
                    <Button x:Name="_addSwitchingTimerRolloverButton" Content="Timer Rollover" Classes="add-component" VerticalAlignment="Center" Margin="0,0,8,4" Click="AddSwitchingTimerRollover_Click"/>
                    <CheckBox x:Name="_switchingSkipFirstNotificationCheck" Content="Skip First Notification" VerticalAlignment="Center" Margin="0,0,0,4" IsCheckedChanged="SwitchingSkipFirstNotification_Changed"/>
                  </WrapPanel>
                </Grid>
                <Grid x:Name="_switchingVfxAttachRow" ColumnDefinitions="150,*" Margin="0,4">
                  <Grid><Button x:Name="_addSwitchingVfxAttachButton" Content="VFX Attach To" Classes="add-component" HorizontalAlignment="Left" Click="AddSwitchingVfxAttach_Click"/><TextBlock x:Name="_switchingVfxAttachLabel" Text="VFX Attach To" VerticalAlignment="Top" Margin="0,9,0,0"/></Grid>
                  <WrapPanel Grid.Column="1" x:Name="_switchingVfxAttachFields"><TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,6,4"/><AutoCompleteBox x:Name="_switchingVfxAttachPicker" Width="50" Margin="0,0,4,4" FilterMode="Contains" MinimumPrefixLength="0"/><WrapPanel x:Name="_switchingVfxAttachChips"/><Button x:Name="_removeSwitchingVfxAttachButton" Classes="remove-button" Click="RemoveSwitchingVfxAttach_Click"/></WrapPanel>
                </Grid>
                <Grid x:Name="_switchingEffectsRow" ColumnDefinitions="150,*" Margin="0,4">
                  <TextBlock Text="Effects" VerticalAlignment="Top" Margin="0,9,0,0"/>
                  <StackPanel Grid.Column="1" Spacing="8"><StackPanel x:Name="_switchingEffectContainers" Spacing="8"/><Button x:Name="_addSwitchingEffectContainerButton" Content="Add Effects" Classes="add-component" HorizontalAlignment="Left" Click="AddSwitchingEffectContainer_Click"/></StackPanel>
                </Grid>

                <Grid x:Name="_newMoonResearchRow" ColumnDefinitions="150,*" Margin="0,4">
                  <TextBlock Text="Research" VerticalAlignment="Top" Margin="0,9,0,0"/>
                  <WrapPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Max Free Amount" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_newMoonMaxFreeBox" Tag="maxfreeresearches" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Rate" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_newMoonRateBox" Tag="freeresearchrate" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                  </WrapPanel>
                </Grid>

                <Grid x:Name="_modifyVfxRow" ColumnDefinitions="150,*" Margin="0,4">
                  <Grid><Button x:Name="_addModifyVfxButton" Content="VFX" Classes="add-component" HorizontalAlignment="Left" Click="AddModifyVfx_Click"/><TextBlock x:Name="_modifyVfxLabel" Text="VFX" VerticalAlignment="Top" Margin="0,9,0,0"/></Grid>
                  <WrapPanel Grid.Column="1" x:Name="_modifyVfxFields">
                    <StackPanel x:Name="_modifyVfxTargetFields" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,4"><TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_modifyVfxTargetBox" Width="200" MaxWidth="200" Margin="0,0,8,0" FilterMode="Contains" MinimumPrefixLength="0"/><TextBlock Text="Bone" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_modifyVfxBoneBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/><Button x:Name="_removeModifyVfxTargetButton" Classes="remove-button" VerticalAlignment="Center" Margin="2,0,0,0" Click="RemoveModifyVfxOption_Click" Tag="target"/></StackPanel>
                    <Button x:Name="_addModifyVfxTargetButton" Content="Target" Classes="add-component" Margin="0,0,8,4" Click="AddModifyVfxOption_Click" Tag="target"/>
                    <StackPanel x:Name="_modifyVfxBirthFields" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,4"><TextBlock Text="Birth" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_modifyVfxBirthBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/><Button x:Name="_removeModifyVfxBirthButton" Classes="remove-button" VerticalAlignment="Center" Margin="2,0,0,0" Click="RemoveModifyVfxOption_Click" Tag="birth"/></StackPanel>
                    <Button x:Name="_addModifyVfxBirthButton" Content="Birth" Classes="add-component" Margin="0,0,8,4" Click="AddModifyVfxOption_Click" Tag="birth"/>
                    <Button x:Name="_removeModifyVfxButton" Classes="remove-button" VerticalAlignment="Center" Margin="2,0,0,4" Click="RemoveModifyVfx_Click"/>
                  </WrapPanel>
                </Grid>

                <Grid x:Name="_unitModifyRow" ColumnDefinitions="150,*" Margin="0,4">
                  <TextBlock Text="Unit Modify" VerticalAlignment="Top" Margin="0,9,0,0"/>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <CheckBox x:Name="_unitModifyKillOnEffectEndCheck"
                              Content="Kill On Effect End" HorizontalAlignment="Left"
                              IsCheckedChanged="UnitModifyKillOnEffectEnd_Changed"/>
                    <StackPanel x:Name="_unitModifyRows" Spacing="8"/>
                    <Button x:Name="_addUnitModifyButton" Content="Add Unit Modify" Classes="add-component" HorizontalAlignment="Left" Click="AddUnitModify_Click"/>
                  </StackPanel>
                </Grid>

                <Grid x:Name="_foxCharmAffectedNumberRow" ColumnDefinitions="150,*" Margin="0,4">
                  <TextBlock Text="Affected Number" VerticalAlignment="Top" Margin="0,9,0,0"/>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel x:Name="_foxCharmAgeRows" Spacing="4"/>
                    <Button x:Name="_addFoxCharmAgeButton" Content="Add Affected Number"
                            Classes="add-component" HorizontalAlignment="Left"
                            Click="AddFoxCharmAge_Click"/>
                  </StackPanel>
                </Grid>

                <Grid x:Name="_foxCharmVfxRow" ColumnDefinitions="150,*" Margin="0,4">
                  <Grid>
                    <Button x:Name="_addFoxCharmVfxButton" Content="VFX" Classes="add-component"
                            HorizontalAlignment="Left" Click="AddFoxCharmVfx_Click"/>
                    <TextBlock x:Name="_foxCharmVfxLabel" Text="VFX" VerticalAlignment="Top"
                               Margin="0,9,0,0"/>
                  </Grid>
                  <WrapPanel Grid.Column="1" x:Name="_foxCharmVfxFields">
                    <StackPanel x:Name="_foxCharmUnitVfxFields" Orientation="Horizontal" Margin="0,0,14,4">
                      <TextBlock Text="Unit" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <AutoCompleteBox x:Name="_foxCharmUnitVfxBox" Width="200" MaxWidth="200"
                                       FilterMode="Contains" MinimumPrefixLength="0"/>
                    </StackPanel>
                    <StackPanel x:Name="_foxCharmTargetVfxFields" Orientation="Horizontal" Margin="0,0,14,4">
                      <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <AutoCompleteBox x:Name="_foxCharmTargetVfxBox" Width="200" MaxWidth="200"
                                       FilterMode="Contains" MinimumPrefixLength="0"/>
                    </StackPanel>
                    <StackPanel x:Name="_foxCharmAreaVfxFields" Orientation="Horizontal" Margin="0,0,2,4">
                      <TextBlock Text="Area" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <AutoCompleteBox x:Name="_foxCharmAreaVfxBox" Width="200" MaxWidth="200"
                                       FilterMode="Contains" MinimumPrefixLength="0"/>
                      <Button x:Name="_removeFoxCharmVfxButton" Classes="remove-button"
                              VerticalAlignment="Center" Margin="2,0,0,0"
                              Click="RemoveFoxCharmVfx_Click"/>
                    </StackPanel>
                  </WrapPanel>
                </Grid>

                <Grid x:Name="_fimbulWolfRow" ColumnDefinitions="150,*" Margin="0,4">
                  <TextBlock Text="Wolf" VerticalAlignment="Top" Margin="0,9,0,0"/>
                  <WrapPanel Grid.Column="1">
                    <StackPanel x:Name="_fimbulWolfUnitFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Unit" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_fimbulWolfPicker" Width="50" Margin="0,0,4,0" FilterMode="Contains" MinimumPrefixLength="0"/><WrapPanel x:Name="_fimbulWolfChips"/></StackPanel>
                    <TextBlock x:Name="_fimbulWolfAmountLabel" Text="Amount" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <StackPanel x:Name="_fimbulWolfSoftCapFields" Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="Soft Cap" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulWolfSoftCapBox" Tag="wolfcountsoftcap" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel x:Name="_fimbulWolfHardCapFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Hard Cap" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulWolfHardCapBox" Tag="wolfcounthardcap" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel x:Name="_fimbulWolfVfxFields" Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="VFX" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_fimbulWolfVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/><Button x:Name="_removeFimbulWolfVfxButton" Classes="remove-button" Click="RemoveFimbulWolfVfx_Click"/></StackPanel>
                    <Button x:Name="_addFimbulWolfVfxButton" Content="VFX" Classes="add-component" Margin="0,0,8,4" Click="AddFimbulWolfVfx_Click"/>
                  </WrapPanel>
                </Grid>
                <Grid x:Name="_fimbulMainPackRow" ColumnDefinitions="150,*" Margin="0,4">
                  <TextBlock Text="Main Pack" VerticalAlignment="Top" Margin="0,9,0,0"/>
                  <WrapPanel Grid.Column="1">
                    <StackPanel x:Name="_fimbulMainPackSizeFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulMainPackSizeBox" Tag="packsize" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel x:Name="_fimbulMainPackTargetFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_fimbulMainPackTargetBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel>
                    <StackPanel x:Name="_fimbulMainPackRadiusFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Spawn Radius" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulMainPackRadiusBox" Tag="packspawnradius" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel x:Name="_fimbulExtraSpawnsFields" Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="Extra Spawns" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulExtraSpawnsBox" Tag="numextramainpackspawns" TextChanged="SpecificNumber_TextChanged"/><Button x:Name="_removeFimbulExtraSpawnsButton" Classes="remove-button" Click="RemoveFimbulExtraSpawns_Click"/></StackPanel>
                    <Button x:Name="_addFimbulExtraSpawnsButton" Content="Extra Spawns" Classes="add-component" Margin="0,0,8,4" Click="AddFimbulExtraSpawns_Click"/>
                  </WrapPanel>
                </Grid>
                <Grid x:Name="_fimbulSecondaryPackRow" ColumnDefinitions="150,*" Margin="0,4">
                  <TextBlock Text="Secondary Pack" VerticalAlignment="Top" Margin="0,9,0,0"/>
                  <WrapPanel Grid.Column="1">
                    <StackPanel x:Name="_fimbulSecondaryPackSizeFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulSecondaryPackSizeBox" Tag="minipacksize" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel x:Name="_fimbulSecondaryPackTargetFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_fimbulSecondaryPackTargetBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel>
                    <StackPanel x:Name="_fimbulSecondaryPackRadiusFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Spawn Radius" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Min" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulSecondaryPackRadiusBox" Tag="minpacktargetspawnradius" TextChanged="SpecificNumber_TextChanged"/><TextBlock Text="Max" VerticalAlignment="Center" Margin="8,0,6,0"/><TextBox x:Name="_fimbulSecondaryPackMaxRadiusBox" Tag="maxpacktargetspawnradius" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                  </WrapPanel>
                </Grid>
                <Grid x:Name="_fimbulWanderRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Wander" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel x:Name="_fimbulWanderDistanceFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Distance" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulWanderDistanceBox" Tag="packwanderdistance" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel x:Name="_fimbulMaxWanderDistanceFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Max Distance" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulMaxWanderDistanceBox" Tag="maxpackwanderdistance" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_fimbulTargetSystemRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Target system" VerticalAlignment="Top" Margin="0,9,0,0"/><WrapPanel Grid.Column="1"><StackPanel x:Name="_fimbulScanIntervalFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Scan interval" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulScanIntervalBox" Tag="packscaninterval" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel x:Name="_fimbulEvalRadiusFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Eval Radius" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulEvalRadiusBox" Tag="spawntargetevalradius" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel x:Name="_fimbulSearchRadiusFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Search Radius" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulSearchRadiusBox" Tag="packattacksearchradius" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_fimbulSnowDriftRow" ColumnDefinitions="150,*" Margin="0,4"><Grid><TextBlock x:Name="_fimbulSnowDriftLabel" Text="Snow Drift" VerticalAlignment="Top" Margin="0,9,0,0"/><Button x:Name="_addFimbulSnowDriftOptionalButton" Content="Snow Drift" Classes="add-component" HorizontalAlignment="Left" Click="AddFimbulSnowDriftOptional_Click"/></Grid><StackPanel Grid.Column="1" Spacing="4"><WrapPanel x:Name="_fimbulSnowDriftRows"/><Button x:Name="_addFimbulSnowDriftButton" Content="Add Snow Drift" Classes="add-component" HorizontalAlignment="Left" Click="AddFimbulSnowDrift_Click"/></StackPanel></Grid>
                <Grid x:Name="_fimbulSoundStrikeRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Strike Time" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel x:Name="_fimbulSlowestStrikeFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Slowest" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulSlowestStrikeBox" Tag="sloweststriketime" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel x:Name="_fimbulFastestStrikeFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Fastest" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_fimbulFastestStrikeBox" Tag="fasteststriketime" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></Grid>

                <Grid x:Name="_cageMainRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Caged Unit" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Float Height" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_cageFloatHeightBox" Tag="targetfloatheight" TextChanged="SpecificNumber_TextChanged"/></StackPanel><CheckBox x:Name="_cageKillAfterEndCheck" Content="Kill After End" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,4"/></WrapPanel></Grid>
                <Grid x:Name="_cageKillSimilarRow" ColumnDefinitions="150,*" Margin="0,4">
                  <Grid><Button x:Name="_addCageKillSimilarButton" Content="Kill Similar" Classes="add-component" HorizontalAlignment="Left" Click="AddCageKillSimilar_Click"/><TextBlock x:Name="_cageKillSimilarLabel" Text="Kill Similar" VerticalAlignment="Top" Margin="0,9,0,0"/></Grid>
                  <Grid Grid.Column="1" x:Name="_cageKillSimilarFields" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <WrapPanel Margin="0,0,8,0"><TextBlock Text="Target Unit Type" VerticalAlignment="Center" Margin="0,0,6,4"/><AutoCompleteBox x:Name="_cageSimilarTypePicker" Width="50" Margin="0,0,4,4" FilterMode="Contains" MinimumPrefixLength="0"/><WrapPanel x:Name="_cageSimilarTypeChips"/></WrapPanel>
                      <WrapPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Resource Cap" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_cageResourceCapBox" Tag="resourcevaluecap" TextChanged="SpecificNumber_TextChanged"/></StackPanel><TextBlock Text="Resource Multiplier" VerticalAlignment="Center" Margin="0,0,6,4"/><WrapPanel x:Name="_cageResourceMultiplierRows"/><Button x:Name="_addCageResourceMultiplierButton" Content="Add Resource Multiplier" Classes="add-component" Margin="0,0,8,4" Click="AddCageResourceMultiplier_Click"/></WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="_removeCageKillSimilarButton" Classes="remove-button" VerticalAlignment="Top" Click="RemoveCageKillSimilar_Click"/>
                  </Grid>
                </Grid>
                <Grid x:Name="_cageVfxRow" ColumnDefinitions="150,*" Margin="0,4"><Grid><Button x:Name="_addCageVfxButton" Content="VFX" Classes="add-component" HorizontalAlignment="Left" Click="AddCageVfx_Click"/><TextBlock x:Name="_cageVfxLabel" Text="VFX" VerticalAlignment="Top" Margin="0,9,0,0"/></Grid><WrapPanel Grid.Column="1" x:Name="_cageVfxFields"><StackPanel x:Name="_cageVfxAreaFields" Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="Area" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_cageVfxAreaBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/><Button x:Name="_removeCageVfxAreaButton" Classes="remove-button" Click="RemoveCageVfxOption_Click" Tag="vfxarea"/></StackPanel><Button x:Name="_addCageVfxAreaButton" Content="Area" Classes="add-component" Margin="0,0,8,4" Click="AddCageVfxOption_Click" Tag="vfxarea"/><StackPanel x:Name="_cageVfxMainTargetFields" Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="Main Target" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_cageVfxMainTargetBox" Width="200" MaxWidth="200" Margin="0,0,8,0" FilterMode="Contains" MinimumPrefixLength="0"/><TextBlock Text="Bone" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_cageVfxMainTargetBoneBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/><Button x:Name="_removeCageVfxMainTargetButton" Classes="remove-button" Click="RemoveCageVfxOption_Click" Tag="vfxmaintarget"/></StackPanel><Button x:Name="_addCageVfxMainTargetButton" Content="Main Target" Classes="add-component" Margin="0,0,8,4" Click="AddCageVfxOption_Click" Tag="vfxmaintarget"/><StackPanel x:Name="_cageVfxMainImpactFields" Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="Main Target Impact" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_cageVfxMainImpactBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/><Button x:Name="_removeCageVfxMainImpactButton" Classes="remove-button" Click="RemoveCageVfxOption_Click" Tag="vfxmaintargetimpact"/></StackPanel><Button x:Name="_addCageVfxMainImpactButton" Content="Main Target Impact" Classes="add-component" Margin="0,0,8,4" Click="AddCageVfxOption_Click" Tag="vfxmaintargetimpact"/><StackPanel x:Name="_cageVfxMarkAnimFields" Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="Mark Anim" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_cageVfxMarkAnimBox" Width="200" MaxWidth="200" Margin="0,0,8,0" FilterMode="Contains" MinimumPrefixLength="0"/><TextBlock Text="Bone" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_cageVfxMarkAnimBoneBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/><Button x:Name="_removeCageVfxMarkAnimButton" Classes="remove-button" Click="RemoveCageVfxOption_Click" Tag="vfxmarkanim"/></StackPanel><Button x:Name="_addCageVfxMarkAnimButton" Content="Mark Anim" Classes="add-component" Margin="0,0,8,4" Click="AddCageVfxOption_Click" Tag="vfxmarkanim"/><StackPanel x:Name="_cageVfxAdditionalImpactFields" Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="Additional Targets Impact" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_cageVfxAdditionalImpactBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/><Button x:Name="_removeCageVfxAdditionalImpactButton" Classes="remove-button" Click="RemoveCageVfxOption_Click" Tag="vfxadditionalimpact"/></StackPanel><Button x:Name="_addCageVfxAdditionalImpactButton" Content="Additional Targets Impact" Classes="add-component" Margin="0,0,8,4" Click="AddCageVfxOption_Click" Tag="vfxadditionalimpact"/><Button x:Name="_removeCageVfxButton" Classes="remove-button" Click="RemoveCageVfx_Click"/></WrapPanel></Grid>
                <Grid x:Name="_cageSoundRow" ColumnDefinitions="150,*" Margin="0,4"><Grid><Button x:Name="_addCageSoundButton" Content="Soundset" Classes="add-component" HorizontalAlignment="Left" Click="AddCageSound_Click"/><TextBlock x:Name="_cageSoundLabel" Text="Soundset" VerticalAlignment="Center"/></Grid><StackPanel Grid.Column="1" x:Name="_cageSoundFields" Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="Additional Target Impact" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_cageAdditionalImpactSoundBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/><Button x:Name="_removeCageSoundButton" Classes="remove-button" Click="RemoveCageSound_Click"/></StackPanel></Grid>

                <Grid x:Name="_earthMonsterUnitRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Earth Monster Unit" VerticalAlignment="Top" Margin="0,9,0,0"/><WrapPanel Grid.Column="1"><AutoCompleteBox x:Name="_earthMonsterUnitBox" Width="200" MaxWidth="200" Margin="0,0,14,4" FilterMode="Contains" MinimumPrefixLength="0"/><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Strike Action" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_earthMonsterStrikeActionBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Crush Action" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_earthMonsterCrushActionBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_earthMonsterStrikeRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Strike" VerticalAlignment="Top" Margin="0,9,0,0"/><StackPanel Grid.Column="1"><WrapPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Number of Additional Strikes" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterAdditionalStrikesBox" Tag="numberofadditionalstrikes" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Interval between Strikes" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterStrikeIntervalBox" Tag="secondsbetweenstrikes" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Unit Limit" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterUnitLimitBox" Tag="strikeunitlimit" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel><WrapPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Min Group Search" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterMinGroupBox" Tag="minimumgroupsize" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Group Search Radius" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterGroupRadiusBox" Tag="groupsearchradius" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Avoid Previous Strike Radius" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterAvoidRadiusBox" Tag="previousstrikeavoidanceradius" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></StackPanel></Grid>
                <Grid x:Name="_earthMonsterRegurgitateRow" ColumnDefinitions="150,*" Margin="0,4"><Grid><Button x:Name="_addEarthMonsterRegurgitateButton" Content="Regurgitate" Classes="add-component" HorizontalAlignment="Left" Click="AddEarthMonsterRegurgitate_Click"/><TextBlock x:Name="_earthMonsterRegurgitateLabel" Text="Regurgitate" VerticalAlignment="Top" Margin="0,9,0,0"/></Grid><WrapPanel Grid.Column="1" x:Name="_earthMonsterRegurgitateFields"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Timing" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterRegurgitateTimingBox" Tag="regurgitatetime" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Duration" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterRegurgitateDurationBox" Tag="regurgitateunitstime" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Height" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterRegurgitateHeightBox" Tag="regurgitateheight" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Anim" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_earthMonsterRegurgitateAnimBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="Anim Duration" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterRegurgitateAnimDurationBox" Tag="regurgitateanimtime" TextChanged="SpecificNumber_TextChanged"/><Button x:Name="_removeEarthMonsterRegurgitateButton" Classes="remove-button" Click="RemoveEarthMonsterRegurgitate_Click"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_earthMonsterChompRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Chomp" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Swallow Timer" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterSwallowTimerBox" Tag="chompthrowswallowtimer" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Throw Height" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterChompHeightBox" Tag="chompthrowheight" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_earthMonsterSwallowRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Swallow" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Player Relation" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="_earthMonsterSwallowRelationBox" Width="200" SelectionChanged="EarthMonsterSwallowRelation_SelectionChanged"/></StackPanel></Grid>
                <Grid x:Name="_earthMonsterThrowRadiusRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Throw Radius" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Upward" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterThrowUpwardBox" Tag="throwupwardsradius" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Outward" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_earthMonsterThrowOutwardBox" Tag="throwoutwardsradius" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_earthMonsterLandImpactRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Land Impact VFX" VerticalAlignment="Center"/><AutoCompleteBox Grid.Column="1" x:Name="_earthMonsterLandImpactBox" Width="200" MaxWidth="200" HorizontalAlignment="Left" FilterMode="Contains" MinimumPrefixLength="0"/></Grid>
                <Grid x:Name="_earthMonsterSoundsRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Soundset" VerticalAlignment="Top" Margin="0,9,0,0"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Emerge" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_earthMonsterEmergeSoundBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Chomp" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_earthMonsterChompSoundBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Regurgitate" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_earthMonsterRegurgitateSoundBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></WrapPanel></Grid>

                <Grid x:Name="_meteorUnitRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Meteor Unit" VerticalAlignment="Center"/><AutoCompleteBox Grid.Column="1" x:Name="_meteorUnitBox" Width="200" MaxWidth="200" HorizontalAlignment="Left" FilterMode="Contains" MinimumPrefixLength="0"/></Grid>
                <Grid x:Name="_meteorStrikesRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Strikes Amount" VerticalAlignment="Top" Margin="0,9,0,0"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Standard Strikes" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_meteorStandardStrikesBox" Tag="numberofstrikes"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Priority Strikes" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_meteorPriorityStrikesBox" Tag="numberofprioritystrikes"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Min Group Size" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_meteorMinGroupSizeBox" Tag="minimumgroupsize"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Group Search Radius" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_meteorGroupSearchRadiusBox" Tag="groupsearchradius"/></StackPanel><CheckBox x:Name="_meteorLargestGroupCheck" Content="Use Largest Group Below Min Size" VerticalAlignment="Center" Margin="0,0,14,4"/><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Secondary Accuracy" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_meteorSecondaryAccuracyBox" Tag="secondaryaccuracy"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_meteorSplashRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Splash VFX" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><TextBlock Text="Land" VerticalAlignment="Center" Margin="0,0,6,4"/><AutoCompleteBox x:Name="_meteorLandVfxBox" Width="200" MaxWidth="200" Margin="0,0,14,4" FilterMode="Contains" MinimumPrefixLength="0"/><TextBlock Text="Water" VerticalAlignment="Center" Margin="0,0,6,4"/><AutoCompleteBox x:Name="_meteorWaterVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></WrapPanel></Grid>
                <Grid x:Name="_meteorSoundsRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Soundset" VerticalAlignment="Top" Margin="0,9,0,0"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="First Approach" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_meteorFirstApproachSoundBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="First Strike" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_meteorFirstStrikeSoundBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Strike" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_meteorStrikeSoundBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Approach" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_meteorApproachSoundBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></WrapPanel></Grid>

                <Grid x:Name="_tornadoMainRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Tornado Unit" VerticalAlignment="Top" Margin="0,9,0,0"/><WrapPanel Grid.Column="1"><AutoCompleteBox x:Name="_tornadoUnitBox" Width="200" MaxWidth="200" Margin="0,0,14,4" FilterMode="Contains" MinimumPrefixLength="0"/><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Damage interval" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_tornadoDamageIntervalBox" Tag="damageinterval"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Search and Damage Scale Radius" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_tornadoGreaterDamageRadiusBox" Tag="greaterdamageradius"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Waypoints Number" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_tornadoWaypointCountBox" Tag="numberofwaypoints"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Spiral Size" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_tornadoSpiralSizeBox" Tag="spiralsize"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_tornadoFunnelRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Funnel" VerticalAlignment="Top" Margin="0,9,0,0"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Radius" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_tornadoFunnelRadiusBox" Tag="funnelradius"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Height" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_tornadoFunnelHeightBox" Tag="funnelheight"/></StackPanel><WrapPanel x:Name="_throwExcludePullHost" Margin="0,0,14,4"><TextBlock Text="Exclude From Pull" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_throwExcludePullPicker" Width="50" Margin="0,0,4,0" FilterMode="Contains" MinimumPrefixLength="0"/><WrapPanel x:Name="_throwExcludePullChips"/><Button x:Name="_removeThrowExcludePullButton" Classes="remove-button" Margin="2,0,0,0" Click="RemoveThrowExclusion_Click" Tag="excludefrompullingintofunnel"/></WrapPanel><Button x:Name="_addThrowExcludePullButton" Content="Exclude From Pull" Classes="add-component" Margin="0,0,8,4" Click="AddThrowExcludePull_Click"/></WrapPanel></Grid>
                <Grid x:Name="_tornadoDebrisRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="Debris Velocity" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><TextBlock Text="XZ" VerticalAlignment="Center" Margin="0,0,6,4"/><TextBox x:Name="_tornadoDebrisXzBox" Tag="debrisxzvelocity" Margin="0,0,14,4"/><TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,6,4"/><TextBox x:Name="_tornadoDebrisYBox" Tag="debrisyvelocity" Margin="0,0,14,4"/><TextBlock Text="Angular" VerticalAlignment="Center" Margin="0,0,6,4"/><TextBox x:Name="_tornadoDebrisAngularBox" Tag="debrisangularvelocity"/></WrapPanel></Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="_statusMessage"
                   Foreground="{DynamicResource MainGoldBrush}" FontWeight="SemiBold"
                   Margin="0,6,0,0" HorizontalAlignment="Center"/>
      </Grid>
    </Border>

    <GridSplitter x:Name="_previewSplitter" Grid.Column="1" Width="5"
                  Background="{DynamicResource SubtleBorderBrush}" ResizeDirection="Columns"/>

    <Border x:Name="_xmlPreviewPanel" Grid.Column="2" Classes="XmlPanel" BorderThickness="1,0,0,0">
      <Grid>
        <Grid x:Name="_xmlPreviewContent" RowDefinitions="Auto,*" Margin="12">
          <Grid ColumnDefinitions="*,Auto" Margin="28,0,0,8">
            <TextBlock Classes="XmlHeader" Text="XML Preview" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="_applyRawXmlButton" Classes="positive" Content="Apply"
                    Padding="12,4" IsVisible="False" Click="ApplyRawXml_Click"/>
          </Grid>
          <avaloniaEdit:TextEditor Grid.Row="1" x:Name="_rawXmlEditor"
                                   FontFamily="Consolas" FontSize="12"
                                   Background="{DynamicResource XmlEditorBrush}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   BorderBrush="{DynamicResource NormalBorderBrush}"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   TextChanged="RawXmlEditor_TextChanged"/>
        </Grid>
        <Button x:Name="_xmlPreviewToggleButton" Content="&#x25B6;"
                Width="20" Height="24" MinWidth="20" MinHeight="24"
                FontSize="10" Padding="0"
                Background="{DynamicResource DeepPanelBrush}"
                BorderBrush="{DynamicResource NormalBorderBrush}"
                BorderThickness="0" CornerRadius="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,8,0,0" ZIndex="1"
                ToolTip.Tip="Collapse XML Preview" Click="XmlPreviewToggle_Click"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
