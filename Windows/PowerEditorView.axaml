                    <Button x:Name="_addFreyrsGiftCreateButton" Content="Add Create" Classes="add-component"
                            HorizontalAlignment="Left" Click="AddFreyrsGiftCreate_Click"/>
                  </StackPanel>
                </Grid>

                <Grid x:Name="_vibrantGenerationRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
