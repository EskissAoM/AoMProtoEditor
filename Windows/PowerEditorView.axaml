                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Large" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_prosperityLargeVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel>
