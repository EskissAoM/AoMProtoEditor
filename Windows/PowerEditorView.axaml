                    <StackPanel x:Name="_locustWayPointCountFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Number" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_locustWayPointCountBox" Tag="swarmwaypoints" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel x:Name="_locustWayPointOffsetFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Offset" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_locustWayPointOffsetBox" Tag="swarmwaypointoffset" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                  </WrapPanel>
                </Grid>
                <Grid x:Name="_locustDamageIntervalRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Damage Interval" VerticalAlignment="Center"/><TextBox Grid.Column="1" HorizontalAlignment="Left" x:Name="_locustDamageIntervalBox" Tag="damageinterval" TextChanged="SpecificNumber_TextChanged"/></Grid>

                <Grid x:Name="_boltUnitsRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Strike Unit" VerticalAlignment="Top" Margin="0,9,0,0"/><WrapPanel Grid.Column="1"><StackPanel x:Name="_boltStrikeUnitFields" Orientation="Horizontal"><AutoCompleteBox x:Name="_boltStrikeUnitBox" Width="200" MaxWidth="200" Margin="0,0,14,4" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel x:Name="_boltSparksVfxFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Sparks VFX" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_boltSparksVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel x:Name="_boltScorchVfxFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Scorch VFX" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_boltScorchVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_boltStrikePositionRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Strike position" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Height" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_boltStrikeHeightBox" Tag="strikeheight" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Offset" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Min" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_boltStrikeMinOffsetBox" Tag="strikeminoffset" Margin="0,0,8,0" TextChanged="SpecificNumber_TextChanged"/><TextBlock Text="Max" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_boltStrikeMaxOffsetBox" Tag="strikemaxoffset" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></Grid>

