                <Grid x:Name="_witherCreepGeneratorsRow" ColumnDefinitions="150,*" Margin="0,4"><Grid><Button x:Name="_addWitherCreepGeneratorsButton" Content="Creep Generators" Classes="add-component" HorizontalAlignment="Left" Click="AddWitherCreepGenerators_Click"/><TextBlock x:Name="_witherCreepGeneratorsLabel" Text="Creep Generators" VerticalAlignment="Center"/></Grid><WrapPanel Grid.Column="1" x:Name="_witherCreepGeneratorsFields"><TextBlock Text="Amount" VerticalAlignment="Center" Margin="0,0,6,4"/><TextBox x:Name="_witherCreepGeneratorsBox" Tag="creepgenerators" Margin="0,0,8,4" TextChanged="SpecificNumber_TextChanged"/><Button x:Name="_removeWitherCreepGeneratorsButton" Classes="remove-button" Click="RemoveWitherCreepGenerators_Click"/></WrapPanel></Grid>

