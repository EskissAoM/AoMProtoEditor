                  <WrapPanel Grid.Column="1"><AutoCompleteBox x:Name="_prosperityTypePicker" Width="50" Margin="0,0,4,4" FilterMode="Contains" MinimumPrefixLength="0"/><WrapPanel x:Name="_prosperityTypeChips"/></WrapPanel>
                </Grid>

