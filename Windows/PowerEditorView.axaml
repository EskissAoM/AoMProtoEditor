                    <StackPanel x:Name="_shiftingSandsFadeTimeFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBox x:Name="_shiftingSandsFadeTimeBox" Tag="unitfadetime" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel x:Name="_shiftingSandsSpawnTimeFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock x:Name="_shiftingSandsSpawnTimeLabel" Text="Spawn time" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_shiftingSandsSpawnTimeBox" Tag="outportalspawntime" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel x:Name="_shiftingSandsScanIntervalFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock x:Name="_shiftingSandsScanIntervalLabel" Text="Scan Interval" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_shiftingSandsScanIntervalBox" Tag="scaninterval" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                  </WrapPanel>
                </Grid>
                <Grid x:Name="_shiftingSandsPlacementRadiusRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Placement Radius" VerticalAlignment="Center"/><TextBox Grid.Column="1" HorizontalAlignment="Left" x:Name="_shiftingSandsPlacementRadiusBox" Tag="placementradius" TextChanged="SpecificNumber_TextChanged"/></Grid>

                <Grid x:Name="_locustSwarmRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
                  <TextBlock Text="Swarm Unit" VerticalAlignment="Center"/>
                  <WrapPanel Grid.Column="1">
                    <StackPanel x:Name="_locustSwarmUnitFields" Orientation="Horizontal" Margin="0,0,14,4"><AutoCompleteBox x:Name="_locustSwarmUnitBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel>
                    <StackPanel x:Name="_locustSwarmCountFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Count" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_locustSwarmCountBox" Tag="swarmcount" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel x:Name="_locustSwarmRadiusFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Radius" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_locustSwarmRadiusBox" Tag="swarmradius" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                  </WrapPanel>
                </Grid>
                <Grid x:Name="_locustWayPointsRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
                  <TextBlock Text="Swarm Way Points" VerticalAlignment="Center"/>
