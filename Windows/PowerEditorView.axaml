                <Grid x:Name="_underworldVfxRow" ColumnDefinitions="150,*" Margin="0,4"><Grid><Button x:Name="_addUnderworldVfxButton" Content="VFX" Classes="add-component" HorizontalAlignment="Left" Click="AddUnderworldVfx_Click"/><TextBlock x:Name="_underworldVfxLabel" Text="VFX" VerticalAlignment="Top" Margin="0,9,0,0"/></Grid><WrapPanel Grid.Column="1" x:Name="_underworldVfxFields"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_underworldStartVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Eidolon Spawn" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_underworldEidolonSpawnVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="For Units Without Birth Anim" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_underworldNoBirthVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="Effect" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_underworldEffectVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><Button x:Name="_removeUnderworldVfxButton" Classes="remove-button" VerticalAlignment="Center" Click="RemoveUnderworldVfx_Click"/></WrapPanel></Grid>
                <Grid x:Name="_underworldLightingRow" ColumnDefinitions="150,*" Margin="0,4">
