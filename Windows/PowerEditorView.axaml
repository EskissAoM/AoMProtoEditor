                    <StackPanel x:Name="_shiftingSandsStartPortalFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Starting location" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_shiftingSandsStartPortalBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel>
                    <StackPanel x:Name="_shiftingSandsDestinationPortalFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Destination" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_shiftingSandsDestinationPortalBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel>
                  </WrapPanel>
                </Grid>
                <Grid x:Name="_shiftingSandsTimingRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
