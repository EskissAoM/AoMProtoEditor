                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Explosion Duration" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_implodeExplosionShakeDurationBox" Tag="explosioncamerashakeduration" TextChanged="SpecificNumber_TextChanged"/><TextBlock Text="Strength" VerticalAlignment="Center" Margin="8,0,6,0"/><TextBox x:Name="_implodeExplosionShakeStrengthBox" Tag="explosioncamerashakestrength" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                </WrapPanel></Grid>

                <Grid x:Name="_pSeedsFarmRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
                  <TextBlock x:Name="_farmProtoMainLabel" Text="Farm Proto" VerticalAlignment="Center"/>
                  <WrapPanel Grid.Column="1">
                    <StackPanel x:Name="_farmProtoFields" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0"><AutoCompleteBox x:Name="_farmProtoBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel>
                    <StackPanel x:Name="_numberToTransformFields" Orientation="Horizontal" Spacing="6"><TextBlock x:Name="_numberToTransformInlineLabel" Text="Number to Transform" VerticalAlignment="Center"/><TextBox x:Name="_numberToTransformBox" Tag="numbertotransform" TextChanged="SpecificNumber_TextChanged"/><Button x:Name="_removeNumberToTransformButton" Classes="remove-button" Click="RemoveSpecificAttribute_Click" Tag="Number to Transform"/></StackPanel>
                  </WrapPanel>
                </Grid>
                <Grid x:Name="_pSeedsVfxRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Farm VFX" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><AutoCompleteBox x:Name="_pSeedsFarmVfxBox" Width="200" MaxWidth="200" Margin="0,0,14,0" FilterMode="Contains" MinimumPrefixLength="0"/><StackPanel Orientation="Horizontal"><TextBlock Text="Farm Target VFX" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_pSeedsFarmTargetVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_stealthLevelRow" ColumnDefinitions="150,Auto,Auto" Margin="0,4,0,4"><TextBlock Text="Stealth Level" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="_stealthLevelBox" Width="100" SelectionChanged="StealthLevel_SelectionChanged"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/></ComboBox><Button Grid.Column="2" x:Name="_removeStealthLevelButton" Classes="remove-button" Margin="2,0,0,0" Click="RemoveSpecificAttribute_Click" Tag="Stealth Level"/></Grid>

                <Grid x:Name="_earthWallRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Wall proto" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><AutoCompleteBox x:Name="_wallProtoBox" Width="200" MaxWidth="200" Margin="0,0,14,0" FilterMode="Contains" MinimumPrefixLength="0"/><StackPanel Orientation="Horizontal"><TextBlock Text="Segment counts" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_wallSegmentCountBox" Tag="wallsegmentcount" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_damageTiersRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Damage Tiers" VerticalAlignment="Top" Margin="0,9,0,0"/><StackPanel Grid.Column="1"><StackPanel x:Name="_damageTierRows" Spacing="4"/><Button x:Name="_addDamageTierButton" Content="Add Damage Tier" Classes="add-component" HorizontalAlignment="Left" Margin="0,4,0,0" Click="AddDamageTier_Click"/></StackPanel></Grid>

                <Grid x:Name="_stealthVfxRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Vanish VFX" VerticalAlignment="Top" Margin="0,9,0,0"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="On Cast" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_vanishCastVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="On Target" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_vanishTargetVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Reappear" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_reappearVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></WrapPanel></Grid>

                <Grid x:Name="_forestVfxRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Forest VFX" VerticalAlignment="Top" Margin="0,9,0,0"/><WrapPanel Grid.Column="1"><StackPanel x:Name="_rootedEnemyVfxFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Rooted enemy" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_rootedEnemyVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel x:Name="_treeAreaVfxFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Tree Area" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_treeAreaVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel x:Name="_treeVfxFields" Orientation="Horizontal" Spacing="6"><TextBlock Text="Tree VFX" VerticalAlignment="Center"/><AutoCompleteBox x:Name="_forestTreeVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/><Button x:Name="_removeForestTreeVfxButton" Classes="remove-button" Click="RemoveSpecificAttribute_Click" Tag="Tree VFX"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_forestTimingRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock x:Name="_stayTimeMainLabel" Text="Stay Time" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel x:Name="_stayTimeFields" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0"><TextBox x:Name="_stayTimeBox" Tag="staytime" TextChanged="SpecificNumber_TextChanged"/><Button x:Name="_removeStayTimeButton" Classes="remove-button" Click="RemoveSpecificAttribute_Click" Tag="Stay Time"/></StackPanel><StackPanel x:Name="_rootDurationFields" Orientation="Horizontal" Spacing="6"><TextBlock x:Name="_rootDurationInlineLabel" Text="Root duration" VerticalAlignment="Center"/><TextBox x:Name="_rootDurationBox" Tag="rootedtime" TextChanged="SpecificNumber_TextChanged"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_rootDamageRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Root damage" VerticalAlignment="Top" Margin="0,9,0,0"/><StackPanel Grid.Column="1"><StackPanel x:Name="_rootDamageRows" Spacing="4"/><Button x:Name="_addRootDamageButton" Content="Add Root damage" Classes="add-component" HorizontalAlignment="Left" Margin="0,4,0,0" Click="AddRootDamage_Click"/></StackPanel></Grid>
                <Grid x:Name="_slowHealMultiplierRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
                  <TextBlock x:Name="_restorationHealingMainLabel" Text="Slow Heal Multiplier" VerticalAlignment="Center"/>
                  <WrapPanel Grid.Column="1">
                    <StackPanel x:Name="_restorationHealSpeedFields" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock x:Name="_restorationHealSpeedInlineLabel" Text="Heal speed" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_restorationHealSpeedBox" Tag="healspeed" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel x:Name="_slowHealFields" Orientation="Horizontal" Spacing="6" Margin="0,0,14,4"><TextBlock x:Name="_slowHealInlineLabel" Text="Slow Heal Multiplier" VerticalAlignment="Center"/><TextBox x:Name="_slowHealMultiplierBox" Tag="slowhealmultiplier" TextChanged="SpecificNumber_TextChanged"/><Button x:Name="_removeSlowHealMultiplierButton" Classes="remove-button" Click="RemoveSpecificAttribute_Click" Tag="Slow Heal Multiplier"/></StackPanel>
                    <StackPanel x:Name="_restorationScanFields" Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Scan interval" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_restorationScanIntervalBox" Tag="scaninterval" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                  </WrapPanel>
                </Grid>

                <Grid x:Name="_tempUnitCreateRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
                  <TextBlock Text="Create Unit" VerticalAlignment="Top" Margin="0,9,0,0"/>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <StackPanel x:Name="_tempUnitCreateRows" Spacing="8"/>
                    <Button x:Name="_addTempUnitCreateButton" Content="Add Create" Classes="add-component"
                            HorizontalAlignment="Left" Click="AddTempUnitCreate_Click"/>
                  </StackPanel>
                </Grid>
                <Grid x:Name="_tempUnitAttachRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
                  <TextBlock Text="Attach Unit" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" x:Name="_tempUnitAttachHost" Orientation="Horizontal" Spacing="6"/>
                </Grid>
                <Grid x:Name="_tempUnitAgeRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
                  <TextBlock Text="Age Adjustment" VerticalAlignment="Top" Margin="0,9,0,0"/>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel x:Name="_tempUnitAgeRows" Spacing="4"/>
                    <Button x:Name="_addTempUnitAgeButton" Content="Add Age Adjustment" Classes="add-component"
                            HorizontalAlignment="Left" Click="AddTempUnitAge_Click"/>
                  </StackPanel>
                </Grid>
                <Grid x:Name="_tempUnitPlacementRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
                  <TextBlock Text="Placement" VerticalAlignment="Center"/>
                  <WrapPanel Grid.Column="1">
                    <CheckBox x:Name="_tempUnitSmoothRotationCheck" Content="Smooth rotation" Margin="0,0,16,0"/>
                    <CheckBox x:Name="_tempUnitForcePlacementCheck" Content="Force Placement" Margin="0,0,16,0"/>
                    <CheckBox x:Name="_tempUnitForceOrientationCheck" Content="Force Orientation"/>
                  </WrapPanel>
                </Grid>
