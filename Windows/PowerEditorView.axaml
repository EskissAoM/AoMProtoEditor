                <Grid x:Name="_powerCloneVfxRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="VFX" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Placement" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_powerClonePlacementVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></Grid>
