                <Grid x:Name="_underworldSuddenDeathRow" ColumnDefinitions="150,*" Margin="0,4"><Grid><Button x:Name="_addUnderworldSuddenDeathButton" Content="Sudden Death" Classes="add-component" HorizontalAlignment="Left" Click="AddUnderworldSuddenDeath_Click"/><TextBlock x:Name="_underworldSuddenDeathLabel" Text="Sudden Death" VerticalAlignment="Center"/></Grid><WrapPanel Grid.Column="1" x:Name="_underworldSuddenDeathFields"><TextBlock Text="Sudden Death Target HP Multiplier" VerticalAlignment="Center" Margin="0,0,6,4"/><TextBox x:Name="_underworldSuddenDeathBox" Tag="suddendeathhpmultiplier" Margin="0,0,8,4"/><Button x:Name="_removeUnderworldSuddenDeathButton" Classes="remove-button" Click="RemoveUnderworldSuddenDeath_Click"/></WrapPanel></Grid>

