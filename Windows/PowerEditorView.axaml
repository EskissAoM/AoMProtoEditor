                <Grid x:Name="_witherKillTypesRow" ColumnDefinitions="150,*" Margin="0,4"><Grid><Button x:Name="_addWitherKillTypesButton" Content="Kill Unit Type" Classes="add-component" HorizontalAlignment="Left" Click="AddWitherKillTypes_Click"/><TextBlock x:Name="_witherKillTypesLabel" Text="Kill Unit Type" VerticalAlignment="Top" Margin="0,9,0,0"/></Grid><WrapPanel Grid.Column="1" x:Name="_witherKillTypesFields"><AutoCompleteBox x:Name="_witherKillTypePicker" Width="50" Margin="0,0,4,4" FilterMode="Contains" MinimumPrefixLength="0"/><WrapPanel x:Name="_witherKillTypeChips"/><Button x:Name="_removeWitherKillTypesButton" Classes="remove-button" Margin="2,0,0,4" Click="RemoveWitherKillTypes_Click"/></WrapPanel></Grid>
