                <Grid x:Name="_pestilenceVfxRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Pestilence VFX" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Small" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_pestilenceSmallVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Large" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_pestilenceLargeVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></WrapPanel></Grid>

                <Grid x:Name="_bronzeArmorRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Armor" VerticalAlignment="Top" Margin="0,9,0,0"/><StackPanel Grid.Column="1" Spacing="8"><StackPanel x:Name="_bronzeArmorRows" Spacing="8"/><Button x:Name="_addBronzeArmorButton" Content="Add Armor" Classes="add-component" HorizontalAlignment="Left" Click="AddBronzeArmor_Click"/></StackPanel></Grid>

                <Grid x:Name="_teleportPortalRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Portal" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Starting location" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_teleportStartPortalBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Destination" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_teleportDestinationPortalBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></WrapPanel></Grid>

