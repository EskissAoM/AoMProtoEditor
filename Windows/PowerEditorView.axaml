ponent" Margin="0,0,8,4" Click="AddFrostArmor_Click"/></WrapPanel></StackPanel></Grid>
                <Grid x:Name="_frostVfxRow" ColumnDefinitions="150,*" Margin="0,4"><TextBlock Text="VFX" VerticalAlignment="Top" Margin="0,9,0,0"/><WrapPanel Grid.Column="1"><StackPanel x:Name="_frostStormHost" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Storm" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_frostStormBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel x:Name="_frostSnowDriftHost" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Snow Drift" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_frostSnowDriftBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></WrapPanel></Grid>
                <Grid x:Name="_frostDriftRow" ColumnDefinitions="150,*" Margin="0,4"><Grid><Button x:Name="_addFrostDriftButton" Content="Drift" Classes="add-component" HorizontalAlignment="Left" Click="AddFrostDrift_Click"/><TextBlock x:Name="_frostDriftLabel" Text="Drift" VerticalAlignment="Center"/></Grid><WrapPanel Grid.Column="1" x:Name="_frostDriftHost"><StackPanel x:Name="_frostSlowestDriftHost" Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Slowest" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_frostSlowestDriftBox" Tag="slowestdrifttime" TextChanged="SpecificNumber_TextChanged"/></StackPanel><StackPanel x:Name="_frostFastestDriftHost" Orientation="Horizontal" Margin="0,0,8,4"><TextBlock Text="Fastest" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="_frostFastestDriftBox" Tag="fastestdrifttime" TextChanged="SpecificNumber_TextChanged"/></StackPanel><Button x:Name="_removeFrostDriftButton" Classes="remove-button" Click="RemoveFrostDrift_Click"/></WrapPanel></Grid>

