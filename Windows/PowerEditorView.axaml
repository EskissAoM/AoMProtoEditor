                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBox x:Name="_vibrantGenerateIntervalBox" Tag="generateinterval" TextChanged="SpecificNumber_TextChanged"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Tree Unit" VerticalAlignment="Center" Margin="0,0,6,0"/><WrapPanel x:Name="_vibrantTreeUnitsHost" Orientation="Horizontal"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Tree VFX" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_vibrantTreeVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel>
                  </WrapPanel>
                </Grid>
                <Grid x:Name="_vibrantRotateRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Rotate Speed" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><TextBlock Text="Min" VerticalAlignment="Center"/><TextBox x:Name="_vibrantRotateMinBox" Tag="minrotatespeed" TextChanged="SpecificNumber_TextChanged"/><TextBlock Text="Max" VerticalAlignment="Center"/><TextBox x:Name="_vibrantRotateMaxBox" Tag="maxrotatespeed" TextChanged="SpecificNumber_TextChanged"/></StackPanel></Grid>
                <Grid x:Name="_vibrantGrowthRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Growth" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><TextBlock Text="Min" VerticalAlignment="Center"/><TextBox x:Name="_vibrantGrowthMinBox" Tag="mingrowspeed" TextChanged="SpecificNumber_TextChanged"/><TextBlock Text="Max" VerticalAlignment="Center"/><TextBox x:Name="_vibrantGrowthMaxBox" Tag="maxgrowspeed" TextChanged="SpecificNumber_TextChanged"/></StackPanel></Grid>
                <Grid x:Name="_vibrantScaleRow" ColumnDefinitions="150,*" Margin="0,4,0,4"><TextBlock Text="Scale" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><TextBlock Text="Min" VerticalAlignment="Center"/><TextBox x:Name="_vibrantScaleMinBox" Tag="minscale" TextChanged="SpecificNumber_TextChanged"/><TextBlock Text="Max" VerticalAlignment="Center"/><TextBox x:Name="_vibrantScaleMaxBox" Tag="maxscale" TextChanged="SpecificNumber_TextChanged"/></StackPanel></Grid>

                <Grid x:Name="_restorationVfxRow" ColumnDefinitions="150,*" Margin="0,4,0,4">
                  <TextBlock Text="Heal VFX" VerticalAlignment="Center"/>
                  <WrapPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><TextBlock Text="Heal" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_restorationHealVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Area" VerticalAlignment="Center" Margin="0,0,6,0"/><AutoCompleteBox x:Name="_restorationAreaVfxBox" Width="200" MaxWidth="200" FilterMode="Contains" MinimumPrefixLength="0"/></StackPanel></WrapPanel>
