<Window
	x:Class="AoMDivineDataEditor.Windows.PickerWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ce="using:AoMDivineDataEditor.Windows"
	xmlns:micons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
	Title="{Binding TitleText}"
	Width="500"
	Height="600"
	MinWidth="300"
	MinHeight="300"
	d:DesignHeight="600"
	d:DesignWidth="500"
	Background="{DynamicResource AppBackgroundBrush}"
	DataContext="{Binding RelativeSource={RelativeSource Self}}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d"
	x:DataType="ce:PickerWindow">
	<Window.Styles>
		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="4" />
		</Style>

		<!-- TextBox clear button -->
		<Style Selector="TextBox.clearable">
			<Setter Property="Padding" Value="8,5,26,5" />
		</Style>
	</Window.Styles>
	<DockPanel Margin="10">
		<!-- Filter -->
		<Grid DockPanel.Dock="Top" Margin="0,0,0,8">
			<TextBox x:Name="_filterBox" Classes="clearable" Text="{Binding Filter, Mode=TwoWay}"
					 PlaceholderText="Filter..."
					 TextChanged="FilterTextBox_TextChanged" />
			<Button Classes="filterClear" HorizontalAlignment="Right" VerticalAlignment="Center"
					Focusable="False" IsTabStop="False" Click="FilterClear_Click"
					IsVisible="False" Background="Transparent" BorderThickness="0"
					Padding="2" Margin="0,0,4,0" Cursor="Hand">
				<micons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="#808080" />
			</Button>
		</Grid>

		<!-- Buttons -->
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
					Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
			<Button Content="Cancel" Click="OnCancel" />
			<Button x:Name="_confirmBtn" Content="Confirm" Click="OnConfirm"
					Classes="positive" IsDefault="True" IsEnabled="False" />
		</StackPanel>

		<!-- Status -->
		<TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="0,6,0,0"
				   Text="{Binding StatusText}" />

		<!-- List -->
		<ListBox x:Name="_list" ItemsSource="{Binding FilteredItems}"
				 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
				 DoubleTapped="ListBox_DoubleTapped">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="ce:PickerItem">
					<StackPanel Orientation="Horizontal" Spacing="0">
						<TextBlock Text="{Binding Group}" Foreground="{Binding GroupBrush}"
								   IsVisible="{Binding ShowGroup}" />
						<TextBlock Text="|" Foreground="{DynamicResource MutedTextBrush}"
								   IsVisible="{Binding ShowGroup}" />
						<TextBlock Text="{Binding Display}" />
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</DockPanel>
</Window>
