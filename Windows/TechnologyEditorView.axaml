<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AoMDivineDataEditor.Windows.TechnologyEditorView"
             Background="#141414" Foreground="#d9d9d9">
  <UserControl.Styles>
    <Style Selector="Button"><Setter Property="Background" Value="#252526"/><Setter Property="Foreground" Value="#d9d9d9"/><Setter Property="Padding" Value="10,5"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#1c1c1c"/><Setter Property="Foreground" Value="#d9d9d9"/><Setter Property="BorderBrush" Value="#3f3f46"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="#1c1c1c"/><Setter Property="BorderBrush" Value="#2d2d30"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#2b3c57"/><Setter Property="Foreground" Value="#ffffff"/></Style>
    <Style Selector="TabItem.editorTab"><Setter Property="Padding" Value="7,3"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#a0a0a0"/><Setter Property="Background" Value="#1c1c1c"/></Style>
    <Style Selector="TabItem.editorTab:selected"><Setter Property="Foreground" Value="#d9d9d9"/><Setter Property="Background" Value="#2b3c57"/></Style>
  </UserControl.Styles>
    <Grid x:Name="_mainGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0"/>
      <ColumnDefinition Width="0"/>
      <ColumnDefinition Width="4*"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="1*" MinWidth="250"/>
    </Grid.ColumnDefinitions>
    <!-- The main window owns the shared entity browser. These controls remain
         as a private selection adapter for the technology editor. -->
    <Border Grid.Column="0" IsVisible="False">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Technologies" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
        <TextBox DockPanel.Dock="Top" x:Name="_searchBox" PlaceholderText="Search..." Margin="0,0,0,6" TextChanged="SearchBox_TextChanged"/>
        <TabStrip DockPanel.Dock="Top" x:Name="_techTabs" Margin="0,0,0,6" SelectionChanged="TechTab_SelectionChanged">
          <TabStripItem FontSize="14" Padding="8,4">Original</TabStripItem>
          <TabStripItem FontSize="14" Padding="8,4">Modified</TabStripItem>
        </TabStrip>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" Margin="0,6,0,0" ColumnSpacing="6">
          <Button Grid.Column="0" Content="Add" Click="AddTech_Click" Background="#2b7a0b" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Button Grid.Column="1" Content="Delete" Click="DeleteTech_Click" Background="#8b0000" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </Grid>
        <ListBox x:Name="_techList" SelectionChanged="TechList_SelectionChanged"/>
      </DockPanel>
    </Border>
    <GridSplitter Grid.Column="1" IsVisible="False" Width="0" />
    <Border Grid.Column="2" Padding="15,15,0,15">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,10">
          <TextBlock Text="Technology :" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" x:Name="_techNameBox" Width="380" MaxWidth="380" HorizontalAlignment="Left" FontSize="16" FontWeight="SemiBold" TextChanged="TechNameBox_TextChanged" LostFocus="TechNameBox_LostFocus"/>
        </Grid>
        <TabControl Grid.Row="1" SelectedIndex="0">
          <TabItem Classes="editorTab" Header="Properties">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="_propertiesPanel" Spacing="10" Margin="0,0,15,0"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Classes="editorTab" Header="Prereqs">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
              <StackPanel x:Name="_prereqsPanel" Spacing="8" Margin="0,0,15,0"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Classes="editorTab" Header="Effects">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="_effectsPanel" Spacing="8" Margin="0,0,15,0"/>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="_statusMessage" Foreground="#e3bd54" FontWeight="Bold" Margin="0,5,0,0" HorizontalAlignment="Center"/>
      </Grid>
    </Border>
    <GridSplitter x:Name="_previewSplitter" Grid.Column="3" Width="5" Background="#2d2d30" ResizeDirection="Columns"/>
    <Border x:Name="_xmlPreviewPanel" Grid.Column="4" Background="#171717" BorderBrush="#2d2d30" BorderThickness="1,0,0,0">
      <Grid>
        <Grid x:Name="_xmlPreviewContent" RowDefinitions="Auto,*" Margin="12">
          <Grid ColumnDefinitions="*,Auto" Margin="28,0,0,8">
            <TextBlock Text="XML Preview" FontWeight="Bold" FontSize="15" Foreground="#e3bd54" VerticalAlignment="Center"/>
          </Grid>
          <TextBox Grid.Row="1" x:Name="_xmlPreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Background="#101010" Foreground="#d9d9d9" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Grid>
        <Button x:Name="_xmlPreviewToggleButton"
                Content="&#x25B6;"
                Width="20" Height="24" MinWidth="20" MinHeight="24"
                FontSize="10" Padding="0" Background="#050505" BorderThickness="0" CornerRadius="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,8,0,0" ZIndex="1"
                ToolTip.Tip="Collapse XML Preview" Click="XmlPreviewToggle_Click"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
