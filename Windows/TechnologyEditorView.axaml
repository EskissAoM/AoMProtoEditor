<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="AoMDivineDataEditor.Windows.TechnologyEditorView"
             Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">
  <UserControl.Styles>
    <Style Selector="TabItem.editorTab"><Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="14"/></Style>
  </UserControl.Styles>
    <Grid x:Name="_mainGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0"/>
      <ColumnDefinition Width="0"/>
      <ColumnDefinition Width="4*"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="1*" MinWidth="250"/>
    </Grid.ColumnDefinitions>
    <!-- The main window owns the shared entity browser. These controls remain
         as a private selection adapter for the technology editor. -->
    <Border Grid.Column="0" IsVisible="False">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Technologies" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
        <TextBox DockPanel.Dock="Top" x:Name="_searchBox" PlaceholderText="Search..." Margin="0,0,0,6" TextChanged="SearchBox_TextChanged"/>
        <TabStrip DockPanel.Dock="Top" x:Name="_techTabs" Margin="0,0,0,6" SelectionChanged="TechTab_SelectionChanged">
          <TabStripItem FontSize="14" Padding="8,4">Original</TabStripItem>
          <TabStripItem FontSize="14" Padding="8,4">Modified</TabStripItem>
        </TabStrip>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" Margin="0,6,0,0" ColumnSpacing="6">
          <Button Grid.Column="0" Classes="add-item" Content="Add" Click="AddTech_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Button Grid.Column="1" Classes="danger" Content="Delete" Click="DeleteTech_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </Grid>
        <ListBox x:Name="_techList" SelectionChanged="TechList_SelectionChanged"/>
      </DockPanel>
    </Border>
    <GridSplitter Grid.Column="1" IsVisible="False" Width="0" />
    <Border Grid.Column="2" Classes="MainPanel" BorderThickness="0" Padding="16,16,4,16">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,10">
          <TextBlock Text="Technology :" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" x:Name="_techNameBox" Width="380" MaxWidth="380" HorizontalAlignment="Left" FontSize="16" FontWeight="SemiBold" TextChanged="TechNameBox_TextChanged" LostFocus="TechNameBox_LostFocus"/>
        </Grid>
        <TabControl Grid.Row="1" SelectedIndex="0">
          <TabItem Classes="editorTab" Header="Properties">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="_propertiesPanel" Spacing="10" Margin="0,0,15,0"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Classes="editorTab" Header="Prereqs">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
              <StackPanel x:Name="_prereqsPanel" Spacing="8" Margin="0,0,15,0"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Classes="editorTab" Header="Effects">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="_effectsPanel" Spacing="8" Margin="0,0,15,0"/>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="_statusMessage" Foreground="{DynamicResource MainGoldBrush}" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center"/>
      </Grid>
    </Border>
    <GridSplitter x:Name="_previewSplitter" Grid.Column="3" Width="5" Background="{DynamicResource SubtleBorderBrush}" ResizeDirection="Columns"/>
    <Border x:Name="_xmlPreviewPanel" Classes="XmlPanel" Grid.Column="4" BorderThickness="1,0,0,0">
      <Grid>
        <Grid x:Name="_xmlPreviewContent" RowDefinitions="Auto,*" Margin="12">
          <Grid ColumnDefinitions="*,Auto" Margin="28,0,0,8">
            <TextBlock Classes="XmlHeader" Text="XML Preview" VerticalAlignment="Center"/>
          </Grid>
          <avaloniaEdit:TextEditor Grid.Row="1" x:Name="_xmlPreview" IsReadOnly="True"
                                   FontFamily="Consolas" FontSize="12"
                                   Background="{DynamicResource XmlEditorBrush}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   BorderBrush="{DynamicResource NormalBorderBrush}"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"/>
        </Grid>
        <Button x:Name="_xmlPreviewToggleButton"
                Content="&#x25B6;"
                Width="20" Height="24" MinWidth="20" MinHeight="24"
                FontSize="10" Padding="0" Background="{DynamicResource DeepPanelBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0" CornerRadius="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,8,0,0" ZIndex="1"
                ToolTip.Tip="Collapse XML Preview" Click="XmlPreviewToggle_Click"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
