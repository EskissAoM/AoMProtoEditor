diff --git a/AoMProtoEditor/Classes/AssetPathDisplayService.cs b/AoMProtoEditor/Classes/AssetPathDisplayService.cs
--- a/AoMProtoEditor/Classes/AssetPathDisplayService.cs
+++ b/AoMProtoEditor/Classes/AssetPathDisplayService.cs
@@
+using Avalonia.Threading;
@@
         control.SelectionChanged += async (_, _) =>
         {
             if (control.SelectedItem is not PathSuggestion suggestion)
                 return;
+
+            state.IsApplyingSelection = true;
+            try
+            {
+                await CommitFullValueAsync(state, suggestion.FullValue);
+                if (!string.Equals(control.Text, suggestion.FullValue, StringComparison.Ordinal))
+                    control.Text = suggestion.FullValue;
+                ToolTip.SetTip(control, suggestion.FullValue);
+            }
+            finally
+            {
+                Dispatcher.UIThread.Post(
+                    () => state.IsApplyingSelection = false,
+                    DispatcherPriority.Background);
+            }
         };
@@
         control.TextChanged += async (_, _) =>
         {
-            if (!control.IsFocused)
+            if (!control.IsFocused || state.IsApplyingSelection)
                 return;
 
-            await CommitFullValueAsync(state, control.Text);
+            var typedValue = control.Text?.Trim() ?? "";
+            if (control.SelectedItem is PathSuggestion selected &&
+                !string.Equals(typedValue, selected.FullValue, StringComparison.OrdinalIgnoreCase))
+            {
+                control.SelectedItem = null;
+            }
+
+            await CommitFullValueAsync(state, typedValue);
         };
@@
         state.FullValue = normalized;
+        state.Suggestions = CreateSuggestions(
+            state.Suggestions.Select(item => item.FullValue).Append(normalized));
         if (state.FullValueChangedAsync != null)
             await state.FullValueChangedAsync(normalized);
@@
         public bool Initialized { get; set; }
+        public bool IsApplyingSelection { get; set; }
     }
