<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:micons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="AoMDivineDataEditor.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <micons:MaterialIconStyles />
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="micons|MaterialIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="1" />
    </Style>
    <Style Selector="Button.remove-button">
      <Setter Property="Content" Value="×" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Background" Value="#8b0000" />
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.remove-button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#b00000" />
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>
    <Style Selector="Button.remove-button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#650000" />
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>
    <Style Selector="Button.remove-button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.chip-remove-button">
      <Setter Property="Content" Value="X" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="LightGray" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip-remove-button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.chip-remove-button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#bfbfbf" />
    </Style>
  </Application.Styles>
</Application>
