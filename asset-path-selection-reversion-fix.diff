+    public static void SetFullValue(Control control, string fullValue, bool notify = false)
+    {
+        var state = States.GetValue(control, _ => new PathState());
+        var normalized = fullValue?.Trim() ?? "";
+        if (string.Equals(state.FullValue, normalized, StringComparison.Ordinal))
+            return;
+
+        state.FullValue = normalized;
+        state.Initialized = true;
+        // Refresh the displayed full/compact path without treating a suggestion
+        // refresh as an editor change. Optional notification is for real reloads.
+        if (notify && state.FullValueChangedAsync != null)
+            _ = state.FullValueChangedAsync(normalized);
+    }
@@
